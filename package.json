{
    "name": "b418-wp-tg-cf7",
    "version": "1.0.0",
    "description": "Admin UI build for the B418 Telegram for Contact Form 7 WordPress plugin",
    "license": "GPL-2.0-or-later",
    "private": true,
    "scripts": {
        "vite-watch:admin": "vite build --watch --config vite.config.js",
        "vite-build:admin": "vite build --config vite.config.js",
        "clean:dist": "rm -rf dist",
        "build": "npm-run-all clean:dist vite-build:admin",
        "watch": "npm-run-all --parallel vite-watch:admin"
    },
    "dependencies": {
        "@branch418/shared": "^1.0.4",
        "vue": "^3.5.27"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.4",
        "npm-run-all": "^4.1.5",
        "sass": "^1.79.4",
        "vite": "^7.3.1"
    }
}
